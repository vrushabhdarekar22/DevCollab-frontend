# ==============================================================================
# Frontend Environment Configuration Template (Vite)
# Copy this file to .env and set the appropriate URL for your environment.
# IMPORTANT: All client-side environment variables in Vite MUST start with `VITE_`
# ==============================================================================

# Base URL for Backend Express REST API and Socket.IO connection
# Development default: http://localhost:8000
# Production example: https://devcollab-backend-qbag.onrender.com
VITE_API_URL=http://localhost:8000
